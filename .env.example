# Server
PORT=3009
NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URL=

# Uzun tasodifiy qatorlar: openssl rand -hex 32
SESSION_SECRET=
SECRET_TOKEN=

# Frontend manzili (bir nechta bo'lsa vergul bilan). Bo'sh qolsa — hamma originga ruxsat (faqat dev uchun)
CLIENT_URL=https://cutking.uz

# HTTPS (SSL) o'rnatilgandan keyin true qiling
COOKIE_SECURE=false
# Frontend va API boshqa-boshqa domenda bo'lsa: none (COOKIE_SECURE=true bilan)
COOKIE_SAMESITE=lax
