<%- include('includes/header') %>
  <link rel="stylesheet" href="/css/home.css" />

  <body>
    <div class="auth-container">
      <div class="auth-box" style="max-width:500px;">

        <div class="auth-logo">
          <div class="brand">✂ CUT<span>KING</span></div>
        </div>
        <div class="auth-sub">Admin Panel</div>
        <hr class="auth-divider" />

        <div class="auth-title">Create your account</div>
        <div class="auth-caption">Register your barbershop</div>

        <% if (typeof message !=='undefined' && message) { %>
          <div class="auth-err" style="display:block">
            <%= message %>
          </div>
          <% } %>

            <form onsubmit="return validateSignupForm()" action="/admin/signup" method="POST"
              enctype="multipart/form-data">

              <!-- Image preview (self-contained, no external file dependency) -->
              <div class="ck-form-group">
                <label class="ck-label">Profile Image</label>
                <div class="signup-img-wrap">
                  <label class="ck-upload-tile round">
                    <input type="file" id="input-file" class="upload-hidden member-image"
                      name="memberImage" accept="image/jpg,image/jpeg,image/png" required />
                    <img class="ck-upload-preview" alt="" />
                    <span class="ck-upload-remove" onclick="ckRemoveSignup(event)">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </span>
                    <div class="ck-upload-empty">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                      <span>Photo</span>
                    </div>
                  </label>
                  <div class="signup-img-info">
                    <span>Upload photo</span>
                    <p>JPG, JPEG, PNG only</p>
                  </div>
                </div>
              </div>

              <div class="ck-form-grid">
                <div class="ck-form-group">
                  <label class="ck-label">Barber Nick *</label>
                  <input class="ck-input member-nick" type="text" name="memberNick" placeholder="cutking_official"
                    required />
                </div>
                <div class="ck-form-group">
                  <label class="ck-label">Phone *</label>
                  <input class="ck-input member-phone" type="text" name="memberPhone" placeholder="010-0000-0000"
                    required />
                </div>
                <div class="ck-form-group">
                  <label class="ck-label">Password *</label>
                  <input class="ck-input member-password" type="password" name="memberPassword" placeholder="••••••••"
                    required />
                </div>
                <div class="ck-form-group">
                  <label class="ck-label">Repeat Password *</label>
                  <input class="ck-input confirm-password" type="password" name="confirmPassword" placeholder="••••••••"
                    required />
                </div>
              </div>

              <input name="memberType" value="BARBER" hidden />

              <button type="submit" class="btn btn-gold btn-full" style="padding:13px;">
                Create Account →
              </button>
            </form>

            <div class="auth-foot">
              Already have an account? <a href="/admin/login">Login</a> ·
              <a href="/admin">Home</a>
            </div>
      </div>
    </div>

    <script type="text/javascript" src="/js/signup.js"></script>
  </body>

  <%- include('includes/footer') %>