{
  "name": "cut-king",
  "version": "1.0.0",
  "description": "This is cut-king project backend",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "start:dev": "nodemon --exec ts-node src/server.ts",
    "build": "rm -rf dist && tsc && cp -r src/views src/public dist/",
